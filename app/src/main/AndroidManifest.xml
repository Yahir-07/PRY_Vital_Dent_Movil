<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para conectarse a las APIs PHP de XAMPP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ACC-08: cámara para la foto de perfil. required=false: la app también se instala en celulares sin cámara -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Para abrir la app de cámara del celular (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PRY_Vital_Dent_Movil">

        <!-- 01. Pantalla de Bienvenida / Principal (Launcher) -->
        <activity
            android:name=".Vista.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 02. Autenticación y Cuentas -->
        <activity android:name=".Vista.clsLoginVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsRegistroVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsRecuperarContrasenaVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsCambiarContrasenaVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsValidacionBiometricaVista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 03. Cuestionarios Iniciales -->
        <activity android:name=".Vista.clsCuestionario1Vista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsCuestionario2Vista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsCuestionario3Vista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 04. Dashboard y Navegación Principal -->
        <activity android:name=".Vista.clsInicioVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsHistorialMedicoVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsDetalleHistorialVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsPerfilPacienteVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsEditarPerfilVista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 05. Citas -->
        <activity android:name=".Vista.clsMisCitasVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsAgendarCitaVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsCitaAgendadaVista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 06. Tratamientos -->
        <activity android:name=".Vista.clsMisTratamientosVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsAvanceTratamientoVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsTipoBracketsVista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 07. Doctores y Contacto -->
        <activity android:name=".Vista.clsPerfilDoctorVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsContactoVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsNuestrosDoctoresVista" />

        <!-- 08. Pagos y Finanzas -->
        <activity android:name=".Vista.clsPagosVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- Realizar pago: Mercado Pago regresa a la app con el enlace vitaldent://pago?referencia=... -->
        <activity
            android:name=".Vista.clsRealizarPagoVista"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vitaldent" android:host="pago" />
            </intent-filter>
        </activity>
        <activity android:name=".Vista.clsPagoAprobadoVista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 10. Multimedia: videos y audios educativos (Fase 4) -->
        <activity android:name=".Vista.clsMultimediaVista" android:exported="false" />
        <activity android:name=".Vista.clsReproductorAudioVista" android:exported="false" />
        <!-- configChanges: al girar a pantalla completa el video no se reinicia -->
        <activity
            android:name=".Vista.clsReproductorVideoVista"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- 11. Cámara: la foto se guarda en la caché de la app y se comparte con la cámara por este proveedor -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_camara" />
        </provider>

        <!-- 09. Sesión / Diálogos de Seguridad -->
        <activity android:name=".Vista.clsSesionPorTerminarVista" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Vista.clsSesionVencidaVista" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 10. Notificaciones Push (Firebase Cloud Messaging) -->
        <service
            android:name=".Vista.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vitaldent_general" />

    </application>

</manifest>