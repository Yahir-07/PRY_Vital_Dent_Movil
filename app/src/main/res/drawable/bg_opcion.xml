<?xml version="1.0" encoding="utf-8"?>
<!-- Casilla de opción (Sí / No, antecedentes): borde oscuro cuando está marcada -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vd_radio_m" />
            <solid android:color="@color/vd_lienzo" />
            <stroke android:width="@dimen/vd_borde_grueso" android:color="@color/vd_texto_primario" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vd_radio_m" />
            <solid android:color="@color/vd_lienzo" />
            <stroke android:width="@dimen/vd_borde_fino" android:color="@color/vd_borde" />
        </shape>
    </item>
</selector>
