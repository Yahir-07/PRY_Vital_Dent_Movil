<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 5c · ¿A quién avisamos? (Paso 3 de 3 · Contacto de emergencia) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_fondo"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbContactoEmergencia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:subtitle="@string/emergencia_paso"
        app:title="@string/emergencia_titulo" />

    <!-- Barra de avance del cuestionario, pegada al encabezado como en Figma -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbPasoRegistro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/emergencia_paso"
        android:max="3"
        android:progress="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbContactoEmergencia"
        app:trackCornerRadius="0dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContactoEmergencia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnContinuar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbPasoRegistro">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/vd_margen_pantalla"
            android:paddingEnd="@dimen/vd_margen_pantalla"
            android:paddingBottom="@dimen/vd_espacio_l">
            <TextView
                android:id="@+id/lblNombreContacto"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etNombreContacto"
                android:text="@string/etiqueta_nombre_completo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombreContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    tools:text="@string/ej_contacto_nombre" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/lblParentesco"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/actvParentesco"
                android:text="@string/etiqueta_parentesco" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilParentesco"
                style="@style/VitalDent.Campo.Desplegable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvParentesco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItems="@array/opciones_parentesco" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/lblTelefonoContacto"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etTelefonoContacto"
                android:text="@string/etiqueta_telefono" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefonoContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefonoContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/lblTelefonoAlterno"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etTelefonoAlterno"
                android:text="@string/etiqueta_telefono_alternativo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefonoAlterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderText="@string/placeholder_opcional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefonoAlterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvAvisoEmergencia"
                style="@style/VitalDent.Aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_l"
                android:text="@string/emergencia_aviso" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbAvisoPrivacidad"
                style="@style/Widget.Material3.CompoundButton.CheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_s"
                android:text="@string/acepto_aviso_privacidad"
                android:textColor="@color/vd_texto_secundario" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAtras"
        style="@style/VitalDent.Boton.Secundario.Primario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vd_margen_pantalla"
        android:layout_marginEnd="@dimen/vd_espacio_s"
        android:layout_marginBottom="@dimen/vd_espacio_l"
        android:text="@string/accion_atras"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnContinuar"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinuar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vd_espacio_s"
        android:layout_marginEnd="@dimen/vd_margen_pantalla"
        android:layout_marginBottom="@dimen/vd_espacio_l"
        android:text="@string/accion_finalizar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnAtras" />

</androidx.constraintlayout.widget.ConstraintLayout>
