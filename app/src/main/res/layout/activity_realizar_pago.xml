<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 14 · Realizar pago con Mercado Pago (Checkout Pro).
     El paciente elige el tratamiento y el monto; los datos de la tarjeta se escriben en la página
     segura de Mercado Pago, la app nunca los recibe. Al volver se muestra el comprobante (pantalla 16). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_fondo"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbRealizarPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:logo="@drawable/logo_encabezado"
        app:logoDescription="@string/cd_logo"
        app:title="@string/realizar_pago_titulo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svRealizarPago"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnPagar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbRealizarPago">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/vd_margen_pantalla">

            <!-- 1. Tratamiento a pagar (desde código: opciones de opciones_pago.php) -->
            <TextView
                android:id="@+id/lblTratamientoPago"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/actvTratamientoPago"
                android:text="@string/etiqueta_tratamiento_pagar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTratamientoPago"
                style="@style/VitalDent.Campo.Desplegable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lblTratamientoPago">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvTratamientoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:text="@string/ej_concepto_endodoncia_s2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Resumen: concepto y saldo pendiente -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvConcepto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_l"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tilTratamientoPago">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/vd_espacio_l">

                    <TextView
                        android:id="@+id/tvConceptoEtiqueta"
                        style="@style/VitalDent.Texto.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etiqueta_concepto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvConcepto"
                        style="@style/VitalDent.Texto.TituloTarjeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vd_espacio_xs"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvConceptoEtiqueta"
                        tools:text="@string/ej_concepto_endodoncia_s2" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/divConcepto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vd_espacio_m"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvConcepto" />

                    <TextView
                        android:id="@+id/tvTotalEtiqueta"
                        style="@style/VitalDent.Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vd_espacio_m"
                        android:text="@string/pagos_saldo_pendiente"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divConcepto" />

                    <TextView
                        android:id="@+id/tvTotal"
                        style="@style/VitalDent.Texto.TituloTarjeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tvTotalEtiqueta"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="@string/ej_monto_1800" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Monto a pagar (puede ser parcial, máximo el saldo) -->
            <TextView
                android:id="@+id/lblMontoPago"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etMontoPago"
                android:text="@string/etiqueta_monto_pagar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvConcepto" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMontoPago"
                style="@style/VitalDent.Campo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lblMontoPago"
                app:prefixText="$"
                tools:helperText="@string/ej_ayuda_monto_maximo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMontoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    tools:text="1800.00" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Medio de pago: Mercado Pago (tarjeta de crédito o débito en su página segura) -->
            <TextView
                android:id="@+id/lblMedioPago"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_medio_pago"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tilMontoPago" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvMercadoPago"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lblMedioPago">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/vd_espacio_m">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbMercadoPago"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="@string/pago_mercado_pago"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ivMercadoPago"
                        style="@style/VitalDent.Miniatura"
                        android:layout_width="@dimen/vd_icono_l"
                        android:layout_height="@dimen/vd_icono_l"
                        android:contentDescription="@null"
                        android:padding="@dimen/vd_espacio_s"
                        android:src="@drawable/ic_pagos"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/rbMercadoPago"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMercadoPago"
                        style="@style/VitalDent.Texto.TituloTarjeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vd_espacio_m"
                        android:text="@string/pago_mercado_pago"
                        app:layout_constraintBottom_toTopOf="@+id/tvMercadoPagoDetalle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivMercadoPago"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvMercadoPagoDetalle"
                        style="@style/VitalDent.Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pago_mercado_pago_detalle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tvMercadoPago"
                        app:layout_constraintTop_toBottomOf="@+id/tvMercadoPago" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAvisoCifrado"
                style="@style/VitalDent.Aviso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_m"
                android:text="@string/pago_aviso_cifrado"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvMercadoPago" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Desde código: getString(R.string.accion_pagar_monto, "$1,800.00") -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPagar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vd_margen_pantalla"
        android:layout_marginEnd="@dimen/vd_margen_pantalla"
        android:text="@string/accion_pagar"
        app:layout_constraintBottom_toTopOf="@+id/tvNotaHuella"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="@string/ej_pagar_monto" />

    <TextView
        android:id="@+id/tvNotaHuella"
        style="@style/VitalDent.Texto.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_s"
        android:layout_marginBottom="@dimen/vd_espacio_l"
        android:text="@string/pago_nota_huella"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
