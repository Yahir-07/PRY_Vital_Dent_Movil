<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 19 · Sesión expirada (vista de MaterialAlertDialogBuilder.setView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/vd_espacio_xl">

    <ImageView
        style="@style/VitalDent.Ilustracion"
        android:layout_width="@dimen/vd_ilustracion"
        android:layout_height="@dimen/vd_ilustracion"
        android:contentDescription="@null"
        android:src="@drawable/ic_candado" />

    <TextView
        style="@style/VitalDent.Texto.Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_l"
        android:text="@string/sesion_expirada_titulo" />

    <TextView
        style="@style/VitalDent.Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_s"
        android:gravity="center"
        android:text="@string/sesion_expirada_mensaje" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSesionIniciar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_l"
        android:text="@string/accion_iniciar_sesion" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSesionHuella"
        style="@style/VitalDent.Boton.Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accion_usar_huella" />

</LinearLayout>
