<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 1 · Bienvenida -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_fondo"
    android:fitsSystemWindows="true"
    android:paddingStart="@dimen/vd_margen_pantalla"
    android:paddingEnd="@dimen/vd_margen_pantalla">

    <ImageView
        android:id="@+id/ivLogo"
        style="@style/VitalDent.Ilustracion"
        android:layout_width="@dimen/vd_logo"
        android:layout_height="@dimen/vd_logo"
        android:contentDescription="@string/cd_logo"
        android:importantForAccessibility="yes"
        android:src="@drawable/ic_logo_vital_dent"
        app:layout_constraintBottom_toTopOf="@+id/tvMarca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvMarca"
        style="@style/VitalDent.Texto.Marca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_xl"
        android:text="@string/app_marca"
        app:layout_constraintBottom_toTopOf="@+id/tvLema"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

    <TextView
        android:id="@+id/tvLema"
        style="@style/VitalDent.Texto.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_m"
        android:gravity="center"
        android:text="@string/bienvenida_lema"
        android:textSize="@dimen/vd_texto_subtitulo"
        app:layout_constraintBottom_toTopOf="@+id/btnIniciarSesion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMarca" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciarSesion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vd_espacio_m"
        android:text="@string/accion_iniciar_sesion"
        app:layout_constraintBottom_toTopOf="@+id/btnCrearCuenta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearCuenta"
        style="@style/VitalDent.Boton.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vd_espacio_l"
        android:text="@string/accion_crear_cuenta"
        app:layout_constraintBottom_toTopOf="@+id/tvPie"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPie"
        style="@style/VitalDent.Texto.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vd_espacio_l"
        android:text="@string/bienvenida_pie"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
