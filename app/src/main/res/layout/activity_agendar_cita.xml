<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 8 · Agendar cita -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_fondo"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbAgendarCita"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/cd_regresar"
        app:navigationIcon="@drawable/ic_atras"
        app:subtitle="@string/agendar_subtitulo"
        app:title="@string/agendar_titulo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svAgendarCita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirmarCita"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbAgendarCita">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/vd_margen_pantalla">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCalendario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Los días sin cupo se validan desde código (minDate / OnDateChangeListener) -->
                <CalendarView
                    android:id="@+id/calCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Desde código: getString(R.string.hora_disponible_fecha, "jueves 12 de nov") -->
            <TextView
                android:id="@+id/tvHoraDisponible"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_l"
                android:text="@string/etiqueta_hora_disponible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvCalendario"
                tools:text="@string/ej_hora_disponible_fecha" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHoras"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHoraDisponible"
                app:spanCount="4"
                tools:itemCount="8"
                tools:listitem="@layout/item_hora" />

            <TextView
                android:id="@+id/tvNotaHorarios"
                style="@style/VitalDent.Texto.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_s"
                android:text="@string/agendar_nota_horarios"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvHoras" />

            <TextView
                android:id="@+id/lblMotivo"
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etMotivo"
                android:text="@string/etiqueta_motivo_cita"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNotaHorarios" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMotivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lblMotivo"
                app:placeholderText="@string/placeholder_motivo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMotivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarCita"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vd_margen_pantalla"
        android:layout_marginEnd="@dimen/vd_margen_pantalla"
        android:layout_marginBottom="@dimen/vd_espacio_l"
        android:text="@string/accion_confirmar_cita"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
