<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 15 · Confirmar pago con huella (BottomSheetDialog).
     La lectura real de la huella se hace con androidx.biometric.BiometricPrompt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vd_lienzo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/vd_espacio_xl">

    <TextView
        style="@style/VitalDent.Texto.Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirmar_pago_titulo" />

    <TextView
        android:id="@+id/tvConfirmarConcepto"
        style="@style/VitalDent.Texto.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_s"
        tools:text="@string/ej_concepto_monto" />

    <ImageView
        android:id="@+id/ivHuella"
        style="@style/VitalDent.Ilustracion"
        android:layout_width="@dimen/vd_ilustracion"
        android:layout_height="@dimen/vd_ilustracion"
        android:layout_marginTop="@dimen/vd_espacio_l"
        android:contentDescription="@null"
        android:src="@drawable/ic_huella" />

    <TextView
        style="@style/VitalDent.Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_l"
        android:text="@string/confirmar_pago_instruccion" />

    <!-- Desde código: resources.getQuantityString(R.plurals.error_huella_intentos, n, n) -->
    <TextView
        android:id="@+id/tvErrorHuella"
        style="@style/VitalDent.Aviso.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_l"
        android:visibility="gone"
        tools:text="@string/ej_error_huella"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarPago"
        style="@style/VitalDent.Boton.Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vd_espacio_s"
        android:text="@string/accion_cancelar_pago" />

</LinearLayout>
