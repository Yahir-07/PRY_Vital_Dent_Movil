<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 4 · Recuperar contraseña -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_fondo"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbRecuperarContrasena"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:logo="@drawable/logo_encabezado"
        app:logoDescription="@string/cd_logo"
        app:title="@string/recuperar_titulo" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svRecuperarContrasena"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverIniciarSesion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbRecuperarContrasena">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/vd_margen_pantalla"
            android:paddingTop="@dimen/vd_espacio_xl"
            android:paddingEnd="@dimen/vd_margen_pantalla"
            android:paddingBottom="@dimen/vd_espacio_l">

            <ImageView
                style="@style/VitalDent.Ilustracion"
                android:layout_width="@dimen/vd_ilustracion"
                android:layout_height="@dimen/vd_ilustracion"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@null"
                android:src="@drawable/ic_correo" />

            <TextView
                style="@style/VitalDent.Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_l"
                android:gravity="center"
                android:text="@string/recuperar_descripcion"
                android:textSize="@dimen/vd_texto_cuerpo" />

            <TextView
                style="@style/VitalDent.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/etCorreoRecuperacion"
                android:text="@string/etiqueta_correo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreoRecuperacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:placeholderText="@string/placeholder_correo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreoRecuperacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionSend"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarEnlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_l"
                android:text="@string/accion_enviar_enlace" />

            <!-- Confirmación: se muestra después de enviar el enlace -->
            <TextView
                android:id="@+id/tvAvisoEnlaceEnviado"
                style="@style/VitalDent.Aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vd_espacio_l"
                android:text="@string/recuperar_aviso_enviado"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverIniciarSesion"
        style="@style/VitalDent.Boton.Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vd_espacio_s"
        android:text="@string/accion_volver_iniciar_sesion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
