<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================================
         TEMA BASE
         Los wireframes de Vital Dent solo definen modo claro, por eso se usa
         Material3.Light. Los colores salen de colors.xml y las medidas de
         dimens.xml; las vistas solo referencian estilos de este archivo.
         ===================================================================== -->
    <style name="Base.Theme.PRY_Vital_Dent_Movil" parent="Theme.Material3.Light.NoActionBar" />

    <!-- Tema de la app: aquí viven TODOS los atributos (values-night solo redefine el padre). -->
    <style name="Theme.PRY_Vital_Dent_Movil" parent="Base.Theme.PRY_Vital_Dent_Movil">
        <!-- Paleta Material 3 -->
        <item name="colorPrimary">@color/vd_primario</item>
        <item name="colorOnPrimary">@color/vd_sobre_primario</item>
        <item name="colorPrimaryContainer">@color/vd_superficie</item>
        <item name="colorOnPrimaryContainer">@color/vd_primario</item>
        <item name="colorSecondary">@color/vd_acento</item>
        <item name="colorOnSecondary">@color/vd_sobre_primario</item>
        <item name="colorSecondaryContainer">@color/vd_superficie</item>
        <item name="colorOnSecondaryContainer">@color/vd_primario</item>
        <item name="android:colorBackground">@color/vd_fondo</item>
        <item name="colorSurface">@color/vd_lienzo</item>
        <item name="colorSurfaceContainerLow">@color/vd_lienzo</item>
        <item name="colorSurfaceContainer">@color/vd_lienzo</item>
        <item name="colorSurfaceContainerHigh">@color/vd_lienzo</item>
        <item name="colorTertiary">@color/vd_acento</item>
        <item name="colorControlNormal">@color/vd_texto_secundario</item>
        <item name="colorOnSurface">@color/vd_texto_primario</item>
        <item name="colorSurfaceVariant">@color/vd_superficie</item>
        <item name="colorOnSurfaceVariant">@color/vd_texto_secundario</item>
        <item name="colorOutline">@color/vd_borde</item>
        <item name="colorOutlineVariant">@color/vd_divisor</item>
        <item name="colorError">@color/vd_error</item>
        <item name="colorOnError">@color/vd_sobre_primario</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/vd_fondo</item>
        <item name="android:textColorLink">@color/vd_acento</item>

        <!-- Estilos por defecto de los componentes (evita repetir style="" en cada vista) -->
        <item name="materialButtonStyle">@style/VitalDent.Boton.Primario</item>
        <item name="materialButtonOutlinedStyle">@style/VitalDent.Boton.Secundario</item>
        <item name="textInputStyle">@style/VitalDent.Campo</item>
        <item name="materialCardViewStyle">@style/VitalDent.Tarjeta</item>
        <item name="toolbarStyle">@style/VitalDent.Encabezado</item>
        <item name="tabStyle">@style/VitalDent.Segmentado</item>
        <item name="bottomNavigationStyle">@style/VitalDent.NavInferior</item>
        <item name="linearProgressIndicatorStyle">@style/VitalDent.Progreso</item>
        <item name="chipStyle">@style/VitalDent.Chip.Etiqueta</item>
        <item name="materialDividerStyle">@style/VitalDent.Divisor</item>
    </style>

    <!-- =====================================================================
         APARIENCIAS DE TEXTO
         ===================================================================== -->
    <style name="TextAppearance.VitalDent.Encabezado" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/vd_texto_encabezado</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vd_texto_primario</item>
    </style>

    <style name="TextAppearance.VitalDent.EncabezadoSubtitulo" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
        <item name="android:textColor">@color/vd_texto_secundario</item>
    </style>

    <style name="TextAppearance.VitalDent.Boton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/vd_texto_cuerpo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.VitalDent.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/vd_texto_cuerpo</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.VitalDent.Nav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/vd_texto_micro</item>
    </style>

    <!-- Pestaña activa de la barra inferior: mismo tamaño, en negritas (Figma: Semi Bold) -->
    <style name="TextAppearance.VitalDent.Nav.Activo" parent="TextAppearance.VitalDent.Nav">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.VitalDent.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- =====================================================================
         TEXTOS (TextView)
         ===================================================================== -->
    <style name="VitalDent.Texto" parent="">
        <item name="android:textColor">@color/vd_texto_primario</item>
        <item name="android:textSize">@dimen/vd_texto_cuerpo</item>
    </style>

    <style name="VitalDent.Texto.Marca" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_marca</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VitalDent.Texto.Titulo" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VitalDent.Texto.Monto" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_monto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VitalDent.Texto.Seccion" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_subtitulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VitalDent.Texto.TituloTarjeta" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_subtitulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VitalDent.Texto.Etiqueta" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">@dimen/vd_espacio_l</item>
        <item name="android:layout_marginBottom">@dimen/vd_espacio_s</item>
    </style>

    <style name="VitalDent.Texto.Secundario" parent="VitalDent.Texto">
        <item name="android:textColor">@color/vd_texto_secundario</item>
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
    </style>

    <style name="VitalDent.Texto.Caption" parent="VitalDent.Texto">
        <item name="android:textColor">@color/vd_texto_terciario</item>
        <item name="android:textSize">@dimen/vd_texto_pequeno</item>
    </style>

    <style name="VitalDent.Texto.Error" parent="VitalDent.Texto">
        <item name="android:textColor">@color/vd_error</item>
        <item name="android:textSize">@dimen/vd_texto_pequeno</item>
    </style>

    <!-- Texto azul de acción ("Ver características", especialidad del doctor) -->
    <style name="VitalDent.Texto.Enlace" parent="VitalDent.Texto">
        <item name="android:textColor">@color/vd_acento</item>
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Sobretítulo en mayúsculas ("EQUIPO MÉDICO", "OPCIÓN CLÁSICA") -->
    <style name="VitalDent.Texto.Sobretitulo" parent="VitalDent.Texto">
        <item name="android:textSize">@dimen/vd_texto_micro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="VitalDent.Texto.Sobretitulo.Acento" parent="VitalDent.Texto.Sobretitulo">
        <item name="android:textColor">@color/vd_acento</item>
    </style>

    <!-- Iniciales del doctor dentro de un recuadro azul claro -->
    <style name="VitalDent.Avatar" parent="VitalDent.Texto">
        <item name="android:background">@drawable/bg_placeholder</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/vd_primario</item>
        <item name="android:textSize">@dimen/vd_texto_avatar</item>
        <item name="android:textStyle">bold</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Fila con ícono a la izquierda (perfil, resumen de cita, requisitos) -->
    <style name="VitalDent.Texto.FilaIcono" parent="VitalDent.Texto">
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/vd_espacio_m</item>
        <item name="android:drawableTint">@color/vd_icono</item>
        <item name="android:minHeight">@dimen/vd_icono_l</item>
    </style>

    <!-- Fila de menú tocable (Perfil > Cuenta) -->
    <style name="VitalDent.Texto.FilaMenu" parent="VitalDent.Texto.FilaIcono">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:minHeight">@dimen/vd_alto_boton</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Requisito de contraseña (✓ / ✕) -->
    <style name="VitalDent.Texto.Requisito" parent="VitalDent.Texto.Caption">
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/vd_espacio_s</item>
        <item name="android:drawableTint">@color/vd_icono</item>
        <item name="android:paddingTop">@dimen/vd_espacio_xs</item>
        <item name="android:paddingBottom">@dimen/vd_espacio_xs</item>
    </style>

    <!-- Pastilla de estado: Confirmada, Pendiente, Aprobado, En curso... -->
    <style name="VitalDent.Estado" parent="VitalDent.Texto">
        <item name="android:background">@drawable/bg_estado</item>
        <item name="android:textSize">@dimen/vd_texto_pequeno</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/vd_espacio_m</item>
        <item name="android:paddingEnd">@dimen/vd_espacio_m</item>
        <item name="android:paddingTop">@dimen/vd_espacio_xs</item>
        <item name="android:paddingBottom">@dimen/vd_espacio_xs</item>
    </style>

    <!-- Pastilla verde (Aprobado) y roja (Rechazado) de la pantalla de pagos -->
    <style name="VitalDent.Estado.Exito" parent="VitalDent.Estado">
        <item name="android:background">@drawable/bg_estado_exito</item>
    </style>

    <style name="VitalDent.Estado.Error" parent="VitalDent.Estado">
        <item name="android:background">@drawable/bg_estado_error</item>
    </style>

    <!-- Avisos informativos y de error (un solo TextView con punto a la izquierda) -->
    <style name="VitalDent.Aviso" parent="VitalDent.Texto">
        <item name="android:background">@drawable/bg_aviso</item>
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
        <item name="android:drawableStart">@drawable/ic_punto_info</item>
        <item name="android:drawablePadding">@dimen/vd_espacio_m</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/vd_espacio_l</item>
    </style>

    <style name="VitalDent.Aviso.Error" parent="VitalDent.Aviso">
        <item name="android:background">@drawable/bg_aviso_error</item>
        <item name="android:drawableStart">@drawable/ic_punto_error</item>
    </style>

    <!-- Casilla de horario (Agendar cita) -->
    <style name="VitalDent.Hora" parent="VitalDent.Texto">
        <item name="android:background">@drawable/bg_hora</item>
        <item name="android:textColor">@color/hora_texto</item>
        <item name="android:textSize">@dimen/vd_texto_etiqueta</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/vd_alto_hora</item>
    </style>

    <!-- Miniatura / ícono en recuadro gris -->
    <style name="VitalDent.Miniatura" parent="">
        <item name="android:background">@drawable/bg_placeholder</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/vd_espacio_m</item>
        <item name="android:tint">@color/vd_icono</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Ilustración grande (logo, éxito, huella) -->
    <style name="VitalDent.Ilustracion" parent="VitalDent.Miniatura">
        <item name="android:padding">@dimen/vd_espacio_xl</item>
    </style>

    <!-- =====================================================================
         BOTONES
         ===================================================================== -->
    <style name="VitalDent.Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/vd_alto_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/vd_primario</item>
        <item name="android:textColor">@color/vd_sobre_primario</item>
        <item name="android:textAppearance">@style/TextAppearance.VitalDent.Boton</item>
        <item name="cornerRadius">@dimen/vd_radio_m</item>
    </style>

    <!-- Botón relleno azul claro: "Crear cuenta" -->
    <style name="VitalDent.Boton.Acento" parent="VitalDent.Boton.Primario">
        <item name="backgroundTint">@color/vd_acento</item>
    </style>

    <!-- Botón rojo: "Cancelar" en Cambiar contraseña -->
    <style name="VitalDent.Boton.Peligro" parent="VitalDent.Boton.Primario">
        <item name="backgroundTint">@color/vd_error</item>
        <item name="android:textColor">@color/vd_texto_primario</item>
    </style>

    <style name="VitalDent.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/vd_alto_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/vd_primario</item>
        <item name="strokeWidth">@dimen/vd_borde_grueso</item>
        <item name="backgroundTint">@color/vd_lienzo</item>
        <item name="android:textColor">@color/vd_texto_primario</item>
        <item name="android:textAppearance">@style/TextAppearance.VitalDent.Boton</item>
        <item name="cornerRadius">@dimen/vd_radio_m</item>
    </style>

    <!-- Contorno con texto azul: "Atrás", "Cerrar sesión", "Cómo llegar" -->
    <style name="VitalDent.Boton.Secundario.Primario" parent="VitalDent.Boton.Secundario">
        <item name="android:textColor">@color/vd_primario</item>
    </style>

    <style name="VitalDent.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/vd_alto_boton</item>
        <item name="android:textColor">@color/vd_texto_primario</item>
        <item name="android:textAppearance">@style/TextAppearance.VitalDent.Boton</item>
    </style>

    <!-- Enlace pequeño del pie de pantalla: "¿Ya tienes cuenta? Inicia sesión" -->
    <style name="VitalDent.Boton.Enlace" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/vd_texto_secundario</item>
        <item name="android:textSize">@dimen/vd_texto_pequeno</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- =====================================================================
         CAMPOS DE TEXTO
         La etiqueta va arriba del campo (TextView), por eso hintEnabled=false.
         ===================================================================== -->
    <style name="VitalDent.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/vd_lienzo</item>
        <item name="boxStrokeColor">@color/campo_borde</item>
        <item name="boxStrokeErrorColor">@color/vd_error</item>
        <item name="boxStrokeWidth">@dimen/vd_borde_fino</item>
        <item name="boxStrokeWidthFocused">@dimen/vd_borde_grueso</item>
        <item name="boxCornerRadiusTopStart">@dimen/vd_radio_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/vd_radio_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/vd_radio_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/vd_radio_m</item>
        <item name="errorTextColor">@color/vd_error</item>
        <item name="helperTextTextColor">@color/vd_texto_terciario</item>
        <item name="placeholderTextColor">@color/vd_texto_terciario</item>
    </style>

    <!-- Campo de varias líneas (Referencia, Motivo de la consulta) -->
    <style name="VitalDent.Campo.Multilinea" parent="VitalDent.Campo">
        <item name="android:minHeight">@dimen/vd_alto_multilinea</item>
    </style>

    <style name="VitalDent.Campo.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/vd_lienzo</item>
        <item name="boxStrokeColor">@color/campo_borde</item>
        <item name="boxStrokeErrorColor">@color/vd_error</item>
        <item name="boxStrokeWidth">@dimen/vd_borde_fino</item>
        <item name="boxStrokeWidthFocused">@dimen/vd_borde_grueso</item>
        <item name="boxCornerRadiusTopStart">@dimen/vd_radio_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/vd_radio_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/vd_radio_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/vd_radio_m</item>
        <item name="placeholderTextColor">@color/vd_texto_terciario</item>
    </style>

    <!-- =====================================================================
         CONTENEDORES Y NAVEGACIÓN
         ===================================================================== -->
    <style name="VitalDent.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/vd_lienzo</item>
        <item name="strokeColor">@color/vd_borde</item>
        <item name="strokeWidth">@dimen/vd_borde_fino</item>
        <item name="cardCornerRadius">@dimen/vd_radio_l</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Encabezado gris superior con título, subtítulo y botón de regreso opcional -->
    <style name="VitalDent.Encabezado" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/vd_superficie</item>
        <item name="android:minHeight">@dimen/vd_alto_encabezado</item>
        <item name="titleTextAppearance">@style/TextAppearance.VitalDent.Encabezado</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.VitalDent.EncabezadoSubtitulo</item>
        <item name="titleTextColor">@color/vd_texto_primario</item>
        <item name="subtitleTextColor">@color/vd_texto_secundario</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <!-- Separación entre el logo pequeño y el título -->
        <item name="titleMarginStart">@dimen/vd_espacio_m</item>
    </style>

    <!-- Control segmentado (Próximas / Anteriores, En curso / Finalizados...) -->
    <style name="VitalDent.Segmentado" parent="Widget.Material3.TabLayout">
        <item name="android:background">@drawable/bg_segmentado</item>
        <item name="tabIndicator">@drawable/bg_segmento_indicador</item>
        <item name="tabIndicatorColor">@color/vd_lienzo</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">@color/vd_texto_primario</item>
        <item name="tabTextColor">@color/vd_texto_secundario</item>
        <item name="tabTextAppearance">@style/TextAppearance.VitalDent.Tab</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
    </style>

    <style name="VitalDent.NavInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/vd_lienzo</item>
        <item name="itemIconTint">@color/nav_icono</item>
        <item name="itemTextColor">@color/nav_texto</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.VitalDent.Nav.Activo</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.VitalDent.Nav</item>
        <item name="itemActiveIndicatorStyle">@style/VitalDent.NavInferior.Indicador</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="VitalDent.NavInferior.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="VitalDent.Progreso" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/vd_primario</item>
        <item name="trackColor">@color/vd_superficie</item>
        <item name="trackThickness">@dimen/vd_alto_progreso</item>
        <item name="trackCornerRadius">@dimen/vd_espacio_xs</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="VitalDent.Divisor" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/vd_divisor</item>
    </style>

    <!-- =====================================================================
         CHIPS
         ===================================================================== -->
    <!-- Etiqueta informativa no tocable (alergias) -->
    <style name="VitalDent.Chip.Etiqueta" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/vd_superficie</item>
        <item name="chipStrokeColor">@color/vd_borde</item>
        <item name="chipStrokeWidth">@dimen/vd_borde_fino</item>
        <item name="chipCornerRadius">@dimen/vd_radio_pastilla</item>
        <item name="android:textColor">@color/vd_texto_primario</item>
        <item name="android:textAppearance">@style/TextAppearance.VitalDent.Chip</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Filtro de selección única (Tod0 / Consultas / Recetas / Tratamientos) -->
    <style name="VitalDent.Chip.Filtro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filtro_fondo</item>
        <item name="chipStrokeColor">@color/vd_borde</item>
        <item name="chipStrokeWidth">@dimen/vd_borde_fino</item>
        <item name="chipCornerRadius">@dimen/vd_radio_pastilla</item>
        <item name="android:textColor">@color/chip_filtro_texto</item>
        <item name="android:textAppearance">@style/TextAppearance.VitalDent.Chip</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- =====================================================================
         FORMAS
         ===================================================================== -->
    <style name="ShapeAppearance.VitalDent.Redondeado" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/vd_radio_l</item>
    </style>

    <!-- =====================================================================
         OPCIONES EN RECUADRO (cuestionario inicial)
         ===================================================================== -->
